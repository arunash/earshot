# ---- Judging (optional; without it Earshot still produces the metrics report
#      and writes the assembled judge prompt for you to paste elsewhere) ----
ANTHROPIC_API_KEY=

# ---- Automated calling via Twilio (optional; `manual` mode needs none of this) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15551234567
# Public HTTPS base URL that Twilio can reach for TwiML + status callbacks.
# A Cloudflare tunnel / ngrok pointing at `earshot serve` works.
EARSHOT_PUBLIC_URL=

# ---- Transcription (optional) ----
# auto | whisper-cpp | faster-whisper | none
EARSHOT_TRANSCRIBER=auto
# Path to a whisper.cpp ggml model, if using whisper-cpp
WHISPER_CPP_MODEL=
